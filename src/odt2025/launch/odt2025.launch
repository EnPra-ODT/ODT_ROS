<launch>
  <!-- ============================================================
      Dual IMU fused velocity node (NO joystick)
      Node: imu_controller
      Sub:  /imu_data_left, /imu_data_right   (Float64MultiArray[7])
      Pub:  /v_mag_left, /v_mag_right         (Float64)
            /deltaRPY_left, /deltaRPY_right   (Float64MultiArray[4])
            /v_mag_active                     (Float64)
      ============================================================ -->
  <node pkg="odt2025" type="imu_controller" name="imu_controller" output="screen">
    <!-- Active-selection params -->
    <param name="active_stale_sec"   value="0.20" />
    <param name="move_thresh_deg"    value="1.0" />
    <param name="alpha_up"           value="0.7" />
    <param name="alpha_down"         value="0.05" />
    <param name="max_drop_cms_per_s" value="200.0" />
    <!-- 0 = MAX(vL,vR), 1 = deltaRPY-weighted blend -->
    <param name="fuse_mode"          value="0" />

    <!-- LEFT channel -->
    <group ns="left">
      <param name="topic"            value="/imu_data_left" />
      <param name="out_topic"        value="/v_mag_left" />
      <param name="out_topic_RPY"    value="/deltaRPY_left" />

      <param name="deadband_x" value="0.15" />
      <param name="deadband_y" value="0.15" />
      <param name="deadband_z" value="0.30" />
      <param name="zupt_steps" value="5" />
      <param name="Q" value="0.05" />
      <param name="R" value="0.20" />
      <param name="lpf_alpha" value="0.3" />
      <param name="q_v" value="0.5" />
      <param name="q_b" value="0.01" />
      <param name="r_zupt" value="1e-4" />
      <param name="dt_min" value="0.001" />
      <param name="dt_max" value="0.10" />
      <param name="rpy_zupt_thresh_deg" value="5.0" />
    </group>

    <!-- RIGHT channel -->
    <group ns="right">
      <param name="topic"            value="/imu_data_right" />
      <param name="out_topic"        value="/v_mag_right" />
      <param name="out_topic_RPY"    value="/deltaRPY_right" />

      <param name="deadband_x" value="0.15" />
      <param name="deadband_y" value="0.15" />
      <param name="deadband_z" value="0.28" />
      <param name="zupt_steps" value="5" />
      <param name="Q" value="0.05" />
      <param name="R" value="0.20" />
      <param name="lpf_alpha" value="0.3" />
      <param name="q_v" value="0.5" />
      <param name="q_b" value="0.01" />
      <param name="r_zupt" value="1e-4" />
      <param name="dt_min" value="0.001" />
      <param name="dt_max" value="0.10" />
      <param name="rpy_zupt_thresh_deg" value="5.0" />
    </group>
  </node>


  <!-- ============================================================
       Kinco CANopen speed node
       Node: pitch_controller (pitch_controller.cpp)
       Sub:  /v_mag_active (Float64, cm/s)
       ============================================================ -->
  <node pkg="odt2025" type="pitch_controller" name="pitch_controller" output="screen">
    <param name="can_iface"          value="can0" />
    <param name="speed_topic"        value="/v_mag_active" />

    <param name="roller_diameter_m"  value="0.04" />
    <param name="gear_ratio"         value="10.0" />
    <param name="encoder_res"        value="65536" />
    <param name="max_rpm"            value="5000" />

    <param name="cmd_refresh_hz"     value="50.0" />
    <param name="speed_scale"        value="0.01" />
    <param name="max_cmd_cms"        value="300.0" />
    <param name="enable_on_start"    value="true" />

    <param name="enable_feedback"    value="false" />
    <param name="poll_hz"            value="10.0" />
    <param name="feedback_topic"     value="/kinco/actual_rpm" />

    <rosparam param="node_ids">[1,2,3,4]</rosparam>
  </node>


  <!-- ============================================================
       Yaw Controller (Dynamixel)
       Sub:  /imu_data_right, /foot_contact_pair
       ============================================================ -->
  <node pkg="odt2025" type="yaw_controller" name="yaw_controller" output="screen">
    <!-- Topics -->
    <param name="right_topic"   value="/imu_data_right" />
    <param name="contact_topic" value="/foot_contact_pair" />

    <!-- Dynamixel -->
    <param name="port" value="/dev/ttyUSB0" />
    <param name="baud" value="1000000" />

    <!-- Control -->
    <param name="zero_on_start"  value="true" />
    <param name="angle_scale"    value="20.0" />
    <param name="min_cmd_period" value="0.01" />

    <!-- If you are using the dynamic-ID version of yaw_controller -->
    <rosparam param="connected_ids">[1,2,3,4]</rosparam>
    <rosparam param="goal_offset_ticks">[0,0,0,0]</rosparam>

    <!-- Limits -->
    <param name="use_limits"    value="true" />
    <param name="min_goal_tick" value="-1048575" />
    <param name="max_goal_tick" value="1048575" />
  </node>


  <!-- Loadcell reader -->
  <node pkg="odt2025" type="loadcell_node.py" name="loadcell_reader" output="screen">
    <param name="port" value="/dev/ttyACM0" />
    <param name="baud" value="115200" />
    <param name="threshold" value="15.0" />
  </node>

  <!-- rosserial socket server (ONLY if you actually need it) -->
  <node pkg="rosserial_server" type="socket_node" name="rosserial_socket" output="screen">
    <!-- Set this if your rosserial client connects to TCP, default is 11411 -->
    <!-- <param name="port" value="11411" /> -->
  </node>

</launch>
